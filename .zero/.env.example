# Zero Wallet — environment configuration.
# Copy to `.env` and adjust. All values are optional.

# Solana RPC endpoint the server proxies to.
# Default: mainnet-beta. For devnet testing use https://api.devnet.solana.com
SOLANA_RPC=https://api.mainnet-beta.solana.com

# HTTP port and bind host.
PORT=5000
HOST=127.0.0.1

# Optional panel-integration config path. The service-suspension hook only
# activates if this file exists. Leave unset to disable panel integration.
PANEL_CONFIG_PATH=

# Comma-separated list of trusted proxies (for rate-limit correctness behind a
# reverse proxy). Default: 127.0.0.1
TRUSTED_PROXIES=127.0.0.1
