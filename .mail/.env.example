# Inpriv Mail — Environment Configuration
# Copy this file to .env and adjust values

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Shared secret for Cloudflare Email Worker webhook (must match Worker env)
INBOUND_EMAIL_SECRET=change_me_generate_with_openssl_rand_hex_32

# CORS origins (comma-separated, or * for dev)
CORS_ORIGINS=https://mail.inpriv.xyz

# SQLite database path
DB_PATH=inpriv.db

# JWT settings (optional — defaults shown)
# JWT_ALGORITHM=HS256
# JWT_TTL_DAYS=30

# Username validation regex (optional — default shown)
# USERNAME_RE=^[a-z0-9](?:[a-z0-9._-]{1,30}[a-z0-9])?$
