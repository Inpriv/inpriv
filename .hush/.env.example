# hush — Environment Configuration
# Copy this file to .env and adjust values

# Admin panel credentials (REQUIRED — server refuses to start without both)
HUSH_ADMIN_USERNAME=your_admin_username
HUSH_ADMIN_PASSWORD=change_me_to_a_strong_password

# Server bind address (optional — defaults shown)
# HUSH_HOST=0.0.0.0
# HUSH_PORT=80
