# Inpriv OSINT — Environment Configuration
# Copy this file to .env and adjust values

# OpenRouter API key (REQUIRED for AI report generation)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# SearXNG instance URL (self-hosted search aggregator — optional, falls back to DuckDuckGo)
SEARXNG_URL=http://localhost:8080

# Default LLM model for OSINT report generation
DEFAULT_MODEL=openai/gpt-4o-mini

# Optional overrides (these are the defaults)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MODELS_CACHE_TTL=600
# HOST=0.0.0.0
# PORT=8001
